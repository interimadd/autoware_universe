<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autoware_traffic_light_pipeline</name>
  <version>0.52.0</version>
  <description>Single-node traffic light recognition (front-end) and fusion (back-end) pipelines composed of the extracted core logics</description>
  <maintainer email="takahisa.ishikawa@tier4.jp">Takahisa Ishikawa</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <build_depend>autoware_cmake</build_depend>

  <!-- 合成対象のコアロジック -->
  <depend>ament_index_cpp</depend>
  <depend>autoware_component_test_framework</depend>
  <depend>autoware_crosswalk_traffic_light_estimator</depend>
  <depend>autoware_image_transport_decompressor</depend>
  <depend>autoware_lanelet2_utils</depend>
  <depend>autoware_map_msgs</depend>
  <depend>autoware_map_projection_loader</depend>
  <depend>autoware_perception_msgs</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>autoware_tensorrt_yolox</depend>
  <depend>autoware_traffic_light_arbiter</depend>
  <depend>autoware_traffic_light_category_merger</depend>
  <depend>autoware_traffic_light_classifier</depend>
  <depend>autoware_traffic_light_map_based_detector</depend>
  <depend>autoware_traffic_light_multi_camera_fusion</depend>
  <depend>autoware_traffic_light_selector</depend>
  <depend>autoware_utils</depend>
  <depend>message_filters</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tier4_perception_msgs</depend>
  <depend>yaml_cpp_vendor</depend>
  <!-- ParameterLoader: reads a production param.yaml without an rclcpp::Node, so the offline
       evaluation tools build their config from the same file, with the same rcl yaml parser and
       the same build_*_config(), that the Nodes do. -->

  <!-- ROS / メッセージ -->

  <!-- evaluation/scripts/evaluate_traffic_light_recognition.py (Phase 2, see
       evaluate_result_implementation_plan.md). perception_eval itself is NOT listed here: it does
       not exist in this workspace's rosdep and must come from a separately-sourced overlay (see
       evaluation/scripts/README.md). -->
  <!-- autoware_agnocast_wrapper / autoware_lanelet2_map_visualizer / autoware_map_loader /
       autoware_traffic_light_visualization / rviz2: RViz visualization of a
       run_traffic_light_pipeline_evaluation result bag (see
       launch/visualize_traffic_light_pipeline_result.launch.xml); none of this package's own
       nodes/executables depend on these, only that launch file does, as a post-hoc viewer. -->
  <exec_depend>autoware_agnocast_wrapper</exec_depend>
  <exec_depend>autoware_lanelet2_extension_python</exec_depend>
  <exec_depend>autoware_lanelet2_map_visualizer</exec_depend>
  <exec_depend>autoware_map_loader</exec_depend>
  <exec_depend>autoware_traffic_light_visualization</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>autoware_cuda_utils</test_depend>
  <test_depend>autoware_test_utils</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>lanelet2_core</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
